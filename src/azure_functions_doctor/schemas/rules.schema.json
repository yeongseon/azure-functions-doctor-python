{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Azure Functions Doctor Rules Schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id", "category", "section", "label",
      "description", "type", "required",
      "condition", "check_order"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier for the rule."
      },
      "category": {
        "type": "string",
        "description": "Top-level grouping category.",
        "enum": [
          "environment",
          "dependencies",
          "structure",
          "project_structure",
          "configuration",
          "bindings",
          "tooling",
          "telemetry",
          "framework",
          "project_health",
          "config",
          "tools"
        ]
      },
      "section": {
        "type": "string",
        "description": "Section used to group checks in output (e.g., python_env)."
      },
      "label": {
        "type": "string",
        "description": "Label displayed in CLI output."
      },
      "description": {
        "type": "string",
        "description": "Description of what this rule checks."
      },
      "type": {
        "type": "string",
        "description": "Handler type used to execute the check.",
        "enum": [
          "compare_version",
          "file_exists",
          "dependency_manifest",
          "env_var_exists",
          "package_installed",
          "package_declared",
          "path_exists",
          "source_code_contains",
          "conditional_exists",
          "callable_detection",
          "executable_exists",
          "any_of_exists",
          "file_glob_check",
          "host_json_property",
          "host_json_version",
          "local_settings_security",
          "host_json_extension_bundle_version",
          "package_forbidden",
          "blueprint_registration",
          "native_dependency_risk",
          "decorator_order",
          "endpoint_metadata",
          "openapi_version_mixing",
          "scan_before_spec",
          "langgraph_anonymous_auth",
          "durable_nondeterminism",
          "unsupported_metadata_version",
          "otel_activation",
          "app_insights_connection",
          "functions_extension_version",
          "linux_fx_version",
          "host_json_log_level_conflict",
          "dev_storage_connection",
          "unpinned_requirements",
          "python_runtime_lifecycle",
          "functions_runtime_lifecycle",
          "hosting_plan_lifecycle",
          "flex_runtime_config",
          "flex_deprecated_settings",
          "flex_deployment_storage",
          "binding_connection_resolution"
        ]
      },
      "required": {
        "type": "boolean",
        "description": "Whether this check is required to pass."
      },
      
      "condition": {
        "type": "object",
        "description": "Condition parameters used by the handler.",
        "properties": {
          "target": { "type": "string" },
          "operator": { "type": "string" },
          "value": {},
          "keyword": { "type": "string" },
          "pypi": { "type": "string" },
          "package": { "type": "string" },
          "file": { "type": "string" },
          "jsonpath": { "type": "string" },
          "targets": { "type": "array", "items": { "type": "string" } },
          "patterns": { "type": "array", "items": { "type": "string" } },
          "decorators": { "type": "array", "items": { "type": "string" }, "description": "For decorator_order: decorator leaf names whose relative order is checked." },
          "mode": { "type": "string", "enum": ["string", "ast"], "description": "For source_code_contains: 'string' (default) or 'ast' for AST-based detection." },
          "scan_names": { "type": "array", "items": { "type": "string" }, "description": "For scan_before_spec: endpoint-scan call names." },
          "spec_names": { "type": "array", "items": { "type": "string" }, "description": "For scan_before_spec: spec-build call names." },
          "flag_missing_auth_level": { "type": "boolean", "description": "For langgraph_anonymous_auth: also flag routes with no auth_level keyword." },
          "blocklist": { "type": "array", "items": { "type": "string" }, "description": "For durable_nondeterminism: forbidden dotted call names." },
          "decorator_names": { "type": "array", "items": { "type": "string" }, "description": "For durable_nondeterminism: orchestrator/entity decorator names." },
          "files": { "type": "array", "items": { "type": "string" }, "description": "For unsupported_metadata_version: metadata file globs." },
          "fields": { "type": "array", "items": { "type": "string" }, "description": "For unsupported_metadata_version: version field names." },
          "supported_versions": { "type": "array", "items": { "type": "string" }, "description": "For unsupported_metadata_version: allowed versions." }
        }
      },
      "hint": {
        "type": "string",
        "description": "Hint message shown to users on failure."
      },
      "severity": {
        "type": "string",
        "description": "Severity wired into runtime output: 'error' maps a failing check to fail, 'warning'/'info' map it to warn. When omitted it is derived from 'required'.",
        "enum": ["error", "warning", "info"]
      },
      "gate": {
        "type": "boolean",
        "description": "Whether a failing check gates the run (fails its section / non-zero exit). Separate from severity. When omitted it is derived from 'required'."
      },
      "tier": {
        "type": "string",
        "description": "Maturity tier of the rule. When omitted it is derived from 'required' (required -> core, optional -> extended).",
        "enum": ["core", "extended", "experimental"]
      },
      "group": {
        "type": "string",
        "description": "Functional group of the rule: 'core' targets Azure runtime/hosting/deployment/bindings/durable/dependency/security correctness; 'integration' targets a specific ecosystem library (OpenAPI, validation, logging/OTel, LangGraph) and is only meaningful when that library is present. When omitted it defaults to 'core'.",
        "enum": ["core", "integration"]
      },
      "fix": {
        "type": "string",
        "description": "Natural language fix instruction (optional)."
      },
      "fix_command": {
        "type": "string",
        "description": "CLI command to fix the issue (optional)."
      },
      "hint_url": {
        "type": "string",
        "description": "URL for documentation or solution (optional).",
        "format": "uri"
      },
      "tags": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Searchable tags or keywords (optional)."
      },
      "impact": {
        "type": "string",
        "description": "Effect of failure if not resolved (optional)."
      },
      "check_order": {
        "type": "integer",
        "description": "Display and execution order of the check.",
        "minimum": 0
      },
      "source_type": {
        "type": "string",
        "description": "Origin classification of this rule.",
        "enum": ["ms_learn", "derived", "heuristic"]
      },
      "source_title": {
        "type": "string",
        "description": "Human-readable title of the primary documentation source."
      },
      "source_url": {
        "type": "string",
        "description": "Canonical URL for the primary documentation source.",
        "format": "uri"
      },
      "why_it_matters": {
        "type": "string",
        "description": "Brief explanation of why this check matters in production."
      },
      "symptoms": {
        "type": "string",
        "description": "Observable symptoms when this check fails in production."
      }
    },
    "additionalProperties": false
  }
}
